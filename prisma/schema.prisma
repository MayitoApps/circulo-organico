generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SOCIO_PERSONAL
  EMPRESA
  AGENCIA
  ADMIN_STAFF
}

enum MembershipTier {
  ORIGEN
  ORO
  DIAMANTE
}

enum MembershipStatus {
  ACTIVA
  PENDIENTE_CONVENIO
  SUSPENDIDA
}

enum B2BProfileType {
  EMPRESA
  AGENCIA
}

enum AuthorizedRole {
  RESERVA_Y_ADMINISTRA
  AUTORIZA_PREMIOS_Y_SALDO
}

enum TransactionType {
  ESTANCIA_HOSPEDAJE
  COMPRA_EMPRESA
  EVENTO_AGENCIA
  CANJE_PUNTOS
  CANJE_SALDO
  BONO_QUINTA_ESTANCIA
}

enum AgencyEventStatus {
  PROXIMO_EVENTO
  REALIZADO_Y_PAGADO
}

enum CommissionStatus {
  SIN_COMISION
  AUTORIZADA
  PAGADA
}

enum RewardCertificateType {
  MASAJE_60_MIN
  NOCHE_REGALO_1
  NOCHES_REGALO_2
  CORTESIA_ESTANCIA
  PREMIO_CATALOGO
}

enum CertificateStatus {
  DISPONIBLE
  CITA_SOLICITADA
  CONFIRMADO
  USADO
  VENCIDO
}

enum ReservationStatus {
  POR_CONFIRMAR
  CONFIRMADA
  TERMINADA
  CANCELADA
}

enum QuoteCategory {
  OTAM_PERSONAL
  OTAM_CORPORATIVO
  AMANECER_MERCH
}

enum RequesterType {
  PERSONA
  EMPRESA
  AGENCIA
}

enum QuoteStatus {
  NUEVA
  EN_REVISION
  COTIZADA
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String
  role            UserRole @default(SOCIO_PERSONAL)
  acceptMarketing Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  membership     Membership?
  createdLedgers TransactionLedger[] @relation("AdminCreatedLedgers")
}

model Membership {
  id                       String           @id @default(cuid())
  userId                   String           @unique
  membershipNumber         String           @unique
  qrToken                  String           @unique @default(uuid())
  tier                     MembershipTier   @default(ORIGEN)
  status                   MembershipStatus @default(ACTIVA)
  pointsBalance            Int              @default(0)
  cashBalanceMxn           Decimal          @default(0) @db.Decimal(12, 2)
  rolling12mSpendMxn       Decimal          @default(0) @db.Decimal(12, 2)
  rolling12mNights         Int              @default(0)
  rolling12mStaysCount     Int              @default(0)
  fifthStayBonusClaimedAt  DateTime?
  assignedAdvisorName      String?
  discountPercentage       Int              @default(15)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  b2bProfile         B2BProfile?
  transactions       TransactionLedger[]
  agencyEvents       AgencyEvent[]
  rewardCertificates RewardCertificate[]
  reservations       Reservation[]
  quoteRequests      QuoteRequest[]
}

model B2BProfile {
  id                  String         @id @default(cuid())
  membershipId        String         @unique
  profileType         B2BProfileType
  legalName           String
  rfc                 String
  businessActivity    String
  responsibleName     String
  responsibleRole     String
  workEmail           String
  contactPhone        String
  fiscalAddress       String
  needsLodging        Boolean        @default(true)
  needsOtamEvents     Boolean        @default(false)
  needsAmanecerMerch  Boolean        @default(false)
  agreementApprovedAt DateTime?
  agreedTariffNotes   String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  membership       Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  authorizedPeople AuthorizedPerson[]
}

model AuthorizedPerson {
  id            String         @id @default(cuid())
  b2bProfileId  String
  fullName      String
  email         String
  phone         String
  roleInAccount AuthorizedRole @default(RESERVA_Y_ADMINISTRA)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  b2bProfile B2BProfile @relation(fields: [b2bProfileId], references: [id], onDelete: Cascade)
}

model HotelProperty {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  tagline           String
  location          String   @default("")
  description       String   @default("")
  baseNightPriceMxn Decimal  @db.Decimal(10, 2)
  hasSpaCenter      Boolean  @default(true)
  imageUrl          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions         TransactionLedger[]
  agencyEvents         AgencyEvent[]
  preferredRewards     RewardCertificate[]
  reservations         Reservation[]
  quoteRequests        QuoteRequest[]
}

model TransactionLedger {
  id                  String          @id @default(cuid())
  membershipId        String
  propertyId          String?
  type                TransactionType
  description         String
  grossAmountMxn      Decimal         @db.Decimal(12, 2)
  netEligibleAmountMxn Decimal        @db.Decimal(12, 2)
  nightsCount         Int             @default(0)
  pointsDelta         Int             @default(0)
  cashDeltaMxn        Decimal         @default(0) @db.Decimal(12, 2)
  checkInDate         DateTime?
  checkOutDate        DateTime?
  isConsecutiveStay   Boolean         @default(false)
  expiresAt           DateTime?
  expiredProcessed    Boolean         @default(false)
  createdByAdminId    String?
  createdAt           DateTime        @default(now())

  membership     Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  property       HotelProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdByAdmin User?          @relation("AdminCreatedLedgers", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([membershipId, createdAt])
  @@index([expiresAt, expiredProcessed])
}

model AgencyEvent {
  id                   String            @id @default(cuid())
  code                 String            @unique
  membershipId         String
  clientName           String
  propertyId           String
  eventDate            DateTime
  netAmountMxn         Decimal           @db.Decimal(12, 2)
  eventTier            MembershipTier
  status               AgencyEventStatus @default(PROXIMO_EVENTO)
  commissionPercentage Int               @default(0)
  commissionAmountMxn  Decimal           @default(0) @db.Decimal(12, 2)
  commissionStatus     CommissionStatus  @default(SIN_COMISION)
  pointsGenerated      Int               @default(0)
  pointsReleased       Boolean           @default(false)
  rewardSummary        String            @default("")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  membership         Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  property           HotelProperty       @relation(fields: [propertyId], references: [id])
  rewardCertificates RewardCertificate[]
}

model RewardCertificate {
  id                  String                @id @default(cuid())
  membershipId        String
  agencyEventId       String?
  type                RewardCertificateType
  title               String
  beneficiaryName     String?
  status              CertificateStatus     @default(DISPONIBLE)
  preferredPropertyId String?
  preferredDate       DateTime?
  preferredTimeSlot   String?
  periodStart         DateTime
  expiresAt           DateTime
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  membership        Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  agencyEvent       AgencyEvent?   @relation(fields: [agencyEventId], references: [id], onDelete: SetNull)
  preferredProperty HotelProperty? @relation(fields: [preferredPropertyId], references: [id], onDelete: SetNull)

  @@index([membershipId, status])
  @@index([expiresAt, status])
}

model Reservation {
  id                    String            @id @default(cuid())
  membershipId          String
  propertyId            String
  checkIn               DateTime
  checkOut              DateTime
  nights                Int
  adults                Int               @default(2)
  baseAmountMxn         Decimal           @db.Decimal(12, 2)
  discountAppliedMxn    Decimal           @default(0) @db.Decimal(12, 2)
  pointsOrCashUsedMxn   Decimal           @default(0) @db.Decimal(12, 2)
  finalPriceMxn         Decimal           @db.Decimal(12, 2)
  selectedCourtesy1     String?
  selectedCourtesy2     String?
  earlyCheckInRequested Boolean           @default(false)
  lateCheckOutRequested Boolean           @default(false)
  requestedByPerson     String?
  status                ReservationStatus @default(POR_CONFIRMAR)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  membership Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  property   HotelProperty @relation(fields: [propertyId], references: [id])

  @@index([membershipId, checkIn])
}

model QuoteRequest {
  id                     String        @id @default(cuid())
  membershipId           String?
  category               QuoteCategory
  requesterType          RequesterType
  propertyId             String?
  experienceOrItems      Json
  participantsCount      Int           @default(1)
  preferredDate          String?
  payWithPointsOrBalance Boolean       @default(false)
  contactName            String
  contactEmail           String
  contactPhone           String
  status                 QuoteStatus   @default(NUEVA)
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  membership Membership?    @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  property   HotelProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
}
