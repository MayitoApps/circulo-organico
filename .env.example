# Base de datos PostgreSQL Serverless en Neon
# Conexión con PgBouncer (-pooler) para la aplicación en Vercel
DATABASE_URL="postgresql://usuario:password@ep-ejemplo-pooler.us-east-2.aws.neon.tech/circulo_organico?sslmode=require"

# Conexión directa (sin -pooler) para migraciones de Prisma
DIRECT_URL="postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/circulo_organico?sslmode=require"

# Auth.js / NextAuth v5
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplazar-con-secreto-aleatorio-de-32-caracteres-minimo"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Seguridad para Vercel Cron Jobs (/api/cron/loyalty-maintenance)
CRON_SECRET="reemplazar-con-secreto-para-cron-vercel"
